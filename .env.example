VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Blog content sync -------------------------------------------------------
# Not prefixed with VITE_ on purpose: Vite only inlines VITE_* into
# import.meta.env, so these never reach the client bundle. They are read via
# process.env by scripts/fetch-notion-posts.ts.
#
# The Vercel build runs that script (npm run build chains npm run content), so
# BOTH values must also be set in Vercel under Settings -> Environment
# Variables for Production and Preview. Without them the Vercel build fails on
# purpose rather than shipping a site with an empty blog.
#
# Locally these are optional: with no .env the sync is skipped and the build
# uses whatever is already in src/content. Fill them in to pull posts locally.
#
# 1. Create an internal integration at notion.so/profile/integrations with
#    "Read content" capability only, and copy the ntn_... secret here.
# 2. Open the Blog database in Notion, then ••• -> Connections -> connect it to
#    that integration. Without this step every query returns object_not_found.
# 3. The database id is the 32-hex string in the database URL:
#    notion.so/<workspace>/<DATABASE_ID>?v=<view_id>
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_BLOG_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
